---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const guides = await getCollection('guides');
---
<BaseLayout title="Полезни статии — Tarifberater24" lang="bg">
  <section class="py-16 px-4">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl font-bold mb-4">Полезни статии</h1>
      <p class="text-lg mb-10">Практични обяснения на германската бюрокрация — без юридически жаргон.</p>

      <div class="space-y-4">
        {guides.map((guide) => (
          <a href={`/guides/${guide.id}/`} class="block p-6 bg-blue-50 rounded-lg border-2 border-blue-200 hover:border-blue-400 transition-colors">
            <h2 class="text-2xl font-bold mb-2">{guide.data.icon} {guide.data.title}</h2>
            <p class="text-gray-700">{guide.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
