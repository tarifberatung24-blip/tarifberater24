---
import { calculateSavings, validateInput } from '../lib/calc';
interface Props { lang: 'bg' | 'de'; }
const { lang } = Astro.props;
const t = lang==='bg'?{title:'Колко спестяваш?',household:'Брой хора',monthly:'Месечна вноска (€)',calc:'Изчисли',savings:'Спестяваш:',year:'годишно'}:{};
---
<div class="max-w-md mx-auto p-6 bg-blue-50 rounded-xl border-2 border-blue-300">
  <h2 class="text-2xl font-bold mb-6">{t.title}</h2>
  <form id="calcForm" class="space-y-4">
    <div>
      <label class="block text-sm font-bold mb-2">{t.household}</label>
      <select id="household" class="w-full px-4 py-2 border rounded-lg">
        <option value="1">1 човек</option>
        <option value="2" selected>2 човека</option>
        <option value="3">3 човека</option>
        <option value="4">4 човека</option>
        <option value="5">5 човека</option>
      </select>
    </div>
    <div>
      <label class="block text-sm font-bold mb-2">{t.monthly}</label>
      <input id="monthly" type="number" value="80" step="5" class="w-full px-4 py-2 border rounded-lg" />
    </div>
    <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700">{t.calc}</button>
  </form>
  <div id="result" class="mt-6 hidden text-center p-4 bg-white rounded-lg border-2 border-green-300">
    <p class="text-gray-600 text-sm mb-2">{t.savings}</p>
    <p id="amount" class="text-4xl font-bold text-green-600 mb-2">€280</p>
    <p class="text-gray-600 text-sm">{t.year}</p>
  </div>
</div>
<script>
  import { calculateSavings, validateInput } from '../lib/calc';
  const form=document.getElementById('calcForm') as HTMLFormElement;
  const result=document.getElementById('result') as HTMLElement;
  const amount=document.getElementById('amount') as HTMLElement;
  function calc(){
    const h=parseInt((document.getElementById('household') as HTMLSelectElement).value);
    const m=parseFloat((document.getElementById('monthly') as HTMLInputElement).value);
    if(!validateInput(h,m))return;
    const res=calculateSavings(h,m);
    amount.textContent='€'+res.potentialSavings.toLocaleString('de-DE');
    result.classList.remove('hidden');
  }
  form.addEventListener('submit',(e)=>{e.preventDefault();calc();});
  calc();
</script>
